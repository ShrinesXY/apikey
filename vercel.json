{
  "version": 2,
  "builds": [
    {
      "src": "backend/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/server.js"
    },
    {
      "src": "/css/(.*)",
      "dest": "frontend/public/css/$1"
    },
    {
      "src": "/js/(.*)",
      "dest": "frontend/public/js/$1"
    },
    {
      "src": "/pages/(.*)",
      "dest": "frontend/public/pages/$1"
    },
    {
      "src": "/",
      "dest": "frontend/public/index.html"
    },
    {
      "src": "/(.*\\.(css|js|ico|png|jpg|svg|webp|woff|woff2))",
      "dest": "frontend/public/$1"
    },
    {
      "src": "/(.*)",
      "dest": "backend/server.js"
    }
  ]
}

